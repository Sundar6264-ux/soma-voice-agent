# Copy to .env and fill in. .env is git-ignored.

# Claude
ANTHROPIC_API_KEY=
# claude-haiku-5-5 costs about a tenth of Opus per call. Check it with scripts/chat.py --script
# (and a few real test calls) before switching; claude-sonnet-5-5 is the middle option.
MODEL=claude-opus-5-5
# low keeps phone replies fast; raise to medium if ordering mistakes show up in transcripts.
EFFORT=low

# Public HTTPS origin Twilio reaches (Cloudflare tunnel hostname), no trailing slash.
PUBLIC_BASE_URL=https://voice.example.com
# Twilio Console > Account > API keys & tokens > Auth Token. Used to verify webhook signatures.
TWILIO_AUTH_TOKEN=
# Local development only: accept unsigned webhooks. Never set this on a public host.
ALLOW_UNSIGNED_TWILIO=

# Opens the kitchen board and the browser test call: visit /login?key=<ADMIN_KEY>.
ADMIN_KEY=
# Signs per-call relay WebSocket URLs. Random per process if empty.
RELAY_SECRET=
# Concurrent calls plus browser test calls; extra phone calls hear a busy message.
MAX_SESSIONS=4

RESTAURANT_FILE=restaurants/demo.yaml
DB_PATH=voiceagent.db

# ConversationRelay voice settings; empty means Twilio's defaults.
# ElevenLabs: RELAY_TTS_PROVIDER=ElevenLabs and RELAY_VOICE=<voiceId>[-<model>][-<speed>_<stability>_<similarity>],
# for example NYC9WEgkq1u4jiqBseQ9-flash_v2_5-1.0_0.8_0.6 (speed 0.7 to 1.2; models flash_v2_5 default,
# flash_v2, turbo_v2_5, turbo_v2). Voice ids come from Twilio's voice search tool. Twilio returns error 64101
# when ElevenLabs is not enabled on the account.
RELAY_LANGUAGE=en-US
RELAY_TTS_PROVIDER=
RELAY_VOICE=
RELAY_TRANSCRIPTION_PROVIDER=
RELAY_SPEECH_MODEL=

# ---- Self-hosted calls: Asterisk on this server (README, "Self-hosted calls") ----
# Setting ASTERISK_TOKEN turns this path on. Any long random string: openssl rand -hex 24
ASTERISK_TOKEN=
AUDIOSOCKET_PORT=9092
ASSEMBLYAI_API_KEY=
# The Base64 credential from the Inworld portal, used exactly as shown there.
INWORLD_API_KEY=
INWORLD_VOICE=Ashley
INWORLD_MODEL=inworld-tts-1.5-mini
# AssemblyAI turn detection, ms of silence before a turn may end / must end (README, "Latency").
# Measured: 250 cut a caller off mid-sentence once; keep 400 unless you re-run scripts/latency_bench.py.
STT_MIN_TURN_SILENCE_MS=400
STT_MAX_TURN_SILENCE_MS=1280
INWORLD_SPEAKING_RATE=1.0

# Carrier SIP line: a Telnyx credential connection or a VoIP.ms sub-account.
# SIP_SERVER is the carrier's registrar, for example sip.telnyx.com or newyork1.voip.ms.
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
# The carrier's signaling IP ranges from its docs, comma separated CIDRs. Calls from anywhere else are rejected.
SIP_MATCH=
# This network's public IPv4 address (what the carrier sees).
EXTERNAL_IP=
LOCAL_NET=192.168.0.0/16
SIP_PORT=5060
# Forward this UDP range on the router to this server.
RTP_START=10000
RTP_END=10099
# Digits the carrier expects for the staff transfer. Default: restaurant staff_phone without the +.
STAFF_DIAL=

# AssemblyAI credit tracking (scripts/stt_budget.py): emails at 50/80/95% of this amount.
STT_CREDIT_USD=50
STT_RATE_PER_HOUR=0.15

# Tailscale phone app (free testing, no carrier): a SIP app such as Linphone logs in with these,
# and only from a Tailscale address. Setting SOFTPHONE_PASSWORD (12+ characters) turns it on.
SOFTPHONE_USER=phone
SOFTPHONE_PASSWORD=

# Testing only: pretend it is this time (restaurant timezone) so orders work at any hour. Leave empty for real use.
DEMO_TIME=
